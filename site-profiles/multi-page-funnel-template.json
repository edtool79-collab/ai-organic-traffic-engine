{
  "id": "multi-page-funnel-template",
  "name": "Multi-Page Funnel: Home -> Pricing -> Contact (Click Template)",
  "description": "Live example of multi-page navigation via real button clicks, URL assertions, reading scrolls, and screenshot capture.",
  "category": "funnel_ux",
  "isBuiltin": true,
  "config": {
    "targetUrl": "http://127.0.0.1:4310/demo-site",
    "pages": [
      "/",
      "/pricing",
      "/contact"
    ],
    "visitCount": 2,
    "minConcurrency": 1,
    "concurrency": 2,
    "firstPagePriority": 80,
    "sessionTimeoutMs": 90000,
    "pageMinMs": 3000,
    "headless": false,
    "engineMode": "crawlee_autoscaled",
    "taskMode": "scenario",
    "taskSteps": [
      {
        "type": "goto",
        "selector": "",
        "value": "/",
        "assertKind": "text_contains",
        "label": "1. Open main landing page"
      },
      {
        "type": "human_browse",
        "selector": "",
        "value": "3000",
        "assertKind": "text_contains",
        "label": "2. Human scroll and hover on home page"
      },
      {
        "type": "hover",
        "selector": "#hero-cta",
        "value": "600",
        "assertKind": "text_contains",
        "label": "3. Hover over primary CTA button"
      },
      {
        "type": "click",
        "selector": "#hero-cta",
        "value": "",
        "assertKind": "text_contains",
        "label": "4. Click primary CTA button on home page"
      },
      {
        "type": "click",
        "selector": "a.btn[href=\"/demo-site/pricing\"]",
        "value": "",
        "assertKind": "text_contains",
        "label": "5. Click through to Pricing page"
      },
      {
        "type": "assert",
        "selector": "",
        "value": "/pricing",
        "assertKind": "url_contains",
        "label": "6. Verify navigation to /pricing"
      },
      {
        "type": "scroll",
        "selector": "",
        "value": "60",
        "assertKind": "text_contains",
        "label": "7. Scroll to review pricing tiers"
      },
      {
        "type": "click",
        "selector": "a.btn[href=\"/demo-site/contact\"]",
        "value": "",
        "assertKind": "text_contains",
        "label": "8. Click \"Start Trial\" to open contact form"
      },
      {
        "type": "assert",
        "selector": "",
        "value": "/contact",
        "assertKind": "url_contains",
        "label": "9. Verify arrival on /contact page"
      },
      {
        "type": "screenshot",
        "selector": "",
        "value": "Multi-Page Funnel Done",
        "assertKind": "text_contains",
        "label": "10. Capture funnel completion screenshot"
      }
    ],
    "keepBrowserOpenMs": 2000,
    "snippet": null,
    "schedule": {
      "enabled": false,
      "startHour": "08:00",
      "endHour": "22:00"
    },
    "devices": {
      "desktopChrome": 40,
      "iphone14": 20,
      "pixel7": 12,
      "desktopFirefox": 10,
      "desktopSafari": 10,
      "ipadPro": 8
    },
    "personas": [
      {
        "name": "quick_scanner",
        "scrollDepth": 0.3,
        "clickRate": 0.5,
        "readTime": [
          500,
          1800
        ],
        "pageCount": [
          1,
          2
        ],
        "idleChance": 0.04,
        "resizeChance": 0,
