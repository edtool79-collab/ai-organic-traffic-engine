# Local-only configuration — copy this file to `.env.local` and fill it in.
#
# `.env.local` is gitignored and is never part of the public repository.
# Nothing here is required to run the engine: each feature that needs a key reports
# itself as "unconfigured" in the dashboard instead of crashing.

# ── Email inbox creation + OTP reading ─────────────────────────────────────────
# All inbox work goes through your own HirePulse gateway (https://gethirepulse.xyz),
# it is not a local mail server. Without one of the three variables below the
# dashboard shows Email: unconfigured and `emailsCreated` stays 0.
#
# Free owner-pilot token (owner only). Takes precedence over the commercial key.
HIREPULSE_OWNER_PILOT_TOKEN=
# Paid key, issued from https://gethirepulse.xyz/credits
# HirePulse Commercial Credits Key (unlocks Live Email/OTP + Hosted Cloud AI QA Gateway via gethirepulse.xyz/credits)
HIREPULSE_CREDIT_KEY=
HIREPULSE_EMAIL_API_KEY=
# Alternative: path to a local JSON that holds {"API_KEYS":{"owner-pilot":"<token>"}}
HIREPULSE_OWNER_PILOT_FILE=

# ── Future HTTP/MCP surface ────────────────────────────────────────────────────
# Bearer token for POST /v1/jobs and POST /mcp. Generated by you, not issued by anyone.
# Leave empty while there is no API server; when the API exists and this is empty the
# server binds to 127.0.0.1 only.
WTG_API_TOKEN=
